ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Optional explicit proxy for environments that require one. The backend does not inherit process-wide proxy variables.
ELEXON_HTTP_PROXY=

# Frontend: leave blank for Vite's local proxy and same-origin Vercel routing.
VITE_API_BASE_URL=

# Local Vite proxy target. Docker Compose overrides this with http://backend:8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
